# Bilemezsin - Environment Variables
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun

# ===================
# Veritabanı Ayarları
# ===================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=bilemezsin

# ===================
# Uygulama Ayarları
# ===================
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
SESSION_SECRET=your_super_secret_session_key_change_this

# ===================
# Admin Hesabı (İlk Kurulum)
# ===================
DEFAULT_ADMIN_EMAIL=admin@bilemezsin.com
DEFAULT_ADMIN_PASSWORD=your_secure_admin_password

# ===================
# Google OAuth
# ===================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ===================
# Facebook OAuth
# ===================
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# ===================
# Email (SMTP) Ayarları
# ===================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@bilemezsin.com
CONTACT_EMAIL=info@bilemezsin.com
